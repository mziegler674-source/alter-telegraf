# Vorlage. Echte Werte gehoeren in .env bzw. .env.local und niemals ins Repository.

DATABASE_URL=
AUTH_SECRET=

# E-Mail-Versand ueber SMTP (World4You).
# Solange SMTP_HOST, SMTP_USER, SMTP_PASSWORD und SMTP_FROM nicht alle
# gesetzt sind, verschickt die Anwendung nichts: Buchungen und
# Reservierungen werden normal gespeichert, der Versandversuch wird als
# "nicht verschickt" protokolliert.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Ohne Angabe richtet sich die Verschluesselung nach dem Port:
# 465 implizit (SMTPS), sonst STARTTLS. STARTTLS wird erzwungen.
# SMTP_SECURE=false

# Optional. Antwortadresse der Gastmails, falls sie von SMTP_FROM abweicht.
# SMTP_REPLY_TO=

# Adresse des Betriebs fuer die Benachrichtigung ueber neue
# Restaurantreservierungen. Ohne Wert entfaellt nur diese Benachrichtigung.
RESERVATION_NOTIFICATION_EMAIL=

# Nur fuer Tests und lokale Entwicklung: mock verschickt nichts, sondern
# merkt sich die Nachrichten im Speicher.
# MAIL_TRANSPORT=mock

# Vertriebskanal (Channel Manager, der Booking.com bedient).
# Solange nicht alle vier Werte gesetzt sind, ist die Anbindung
# ABGESCHALTET: Buchungen, Kalender und Verfuegbarkeit laufen normal weiter,
# es wird nur nichts nach aussen gemeldet und nichts uebernommen.
# Derzeit implementiert: "mock" (nur fuer Tests und lokale Entwicklung).
# Welcher Anbieter in Frage kommt und was er verlangt, steht in
# docs/booking-com-integration.md.
CHANNEL_PROVIDER=
CHANNEL_PROPERTY_ID=
CHANNEL_API_TOKEN=
CHANNEL_WEBHOOK_SECRET=

# Geheimnis fuer den geplanten Lauf unter /api/cron/channel.
# Ohne diesen Wert ist der Endpunkt abgeschaltet.
CRON_SECRET=

# Kreditkartengarantie des Hotels.
# Solange diese drei Werte fehlen, ist die Garantie abgeschaltet: Die
# Buchungsstrecke laeuft dann unveraendert mit Zahlung vor Ort.
# Ausschliesslich Testschluessel (sk_test_/pk_test_) verwenden.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Gibt "stripe listen" aus (whsec_...), nur fuer den lokalen Testlauf:
STRIPE_WEBHOOK_SECRET=

# Nur setzen, wenn der Echtbetrieb bewusst freigegeben wird. Ohne diesen
# Schalter weist die Anwendung einen Live-Schluessel ab.
# STRIPE_ALLOW_LIVE=true
